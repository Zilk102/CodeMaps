{
  "name": "codemaps",
  "productName": "CodeMaps",
  "version": "1.1.15",
  "author": {
    "name": "Zilk102",
    "email": "moskvi-ivan@yandex.ru"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Zilk102/CodeMaps.git"
  },
  "resolutions": {
    "@electron/asar/**/brace-expansion": "1.1.18",
    "@electron/universal/minimatch/brace-expansion": "2.0.2",
    "@typescript-eslint/**/brace-expansion": "5.0.9",
    "@xmldom/xmldom": "0.9.12",
    "@babel/core": "7.29.6",
    "app-builder-lib/minimatch/brace-expansion": "5.0.8",
    "baseline-browser-mapping": "2.11.0",
    "browserslist": "4.28.7",
    "body-parser": "2.3.0",
    "cmake-js": "8.0.0",
    "dir-compare/minimatch/brace-expansion": "1.1.18",
    "eslint/**/brace-expansion": "1.1.18",
    "eslint-plugin-react/minimatch/brace-expansion": "1.1.18",
    "fast-uri": "3.1.6",
    "filelist/minimatch/brace-expansion": "2.0.2",
    "form-data": "4.0.6",
    "hono": "4.13.7",
    "ip-address": "10.3.1",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.19",
    "postcss": "8.5.28",
    "qs": "6.16.0",
    "tmp": "0.2.7",
    "undici": "7.29.0",
    "vite": "8.0.16"
  },
  "license": "MIT",
  "description": "Living Blueprint for Code",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm run electron:wait\"",
    "electron:wait": "wait-on tcp:5173 && tsc -p electron/tsconfig.json && electron .",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "postinstall": "node scripts/patch-tree-sitter-wasms.js",
    "clean:build": "node scripts/clean-build.js",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "package:portable": "node scripts/patch-tree-sitter-wasms.js && cross-env NODE_OPTIONS=--max-old-space-size=8192 electron-builder --win portable --x64",
    "build": "npm run clean:build && npm run typecheck && npm run build:renderer && npm run build:electron && node scripts/patch-tree-sitter-wasms.js && electron-builder",
    "build:portable": "npm run clean:build && npm run typecheck && npm run build:renderer && npm run build:electron && npm run package:portable",
    "mcp:smoke": "node scripts/mcp-smoke-test.mjs",
    "test:shutdown:e2e": "npm run build:electron && node scripts/e2e-shutdown-test.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "build": {
    "productName": "CodeMaps",
    "afterPack": "scripts/after-pack-cleanup.js",
    "publish": [
      {
        "provider": "github",
        "owner": "Zilk102",
        "repo": "CodeMaps"
      }
    ],
    "appId": "com.codemaps.app",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CodeMaps-${version}-win-${arch}.${ext}",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.png",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CodeMaps",
      "license": "LICENSE.md",
      "artifactName": "CodeMaps-${version}-setup-${arch}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CodeMaps-${version}-linux-${arch}.${ext}",
      "category": "Development"
    },
    "files": [
      "dist-renderer/**/*",
      "dist-electron/**/*",
      "build/**/*",
      "package.json",
      "!**/node_modules/kuzu/kuzu-source{,/**/*}",
      "!**/node_modules/kuzu/node_modules/.bin{,/**/*}"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/*.wasm",
      "dist-electron/worker.js"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "chokidar": "^5.0.0",
    "cors": "^2.8.6",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9",
    "express": "^5.2.1",
    "fast-glob": "^3.3.3",
    "i18next": "26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "kuzu": "^0.11.3",
    "p-limit": "7.3.2",
    "piscina": "5.3.2",
    "react-i18next": "17.0.13",
    "safe-regex": "^2.1.1",
    "simple-git": "^3.36.0",
    "tree-sitter-wasms": "^0.1.13",
    "typescript": "^5.0.0",
    "web-tree-sitter": "~0.25.10",
    "ws": "8.21.3",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "26.1.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/safe-regex": "^1.1.6",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "9.2.4",
    "cross-env": "^10.1.0",
    "electron": "42.11.3",
    "electron-builder": "26.15.3",
    "elkjs": "^0.12.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "3.9.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-zoom-pan-pinch": "4.2.0",
    "tailwindcss": "4.3.3",
    "vite": "8.0.16",
    "vitest": "4.1.11",
    "wait-on": "9.1.0"
  }
}
